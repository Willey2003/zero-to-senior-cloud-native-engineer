{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteOnlyOwnPrefix",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::lab-app-bucket/app1/*"
    },
    {
      "Sid": "ListOnlyOwnPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::lab-app-bucket",
      "Condition": {"StringLike": {"s3:prefix": ["app1/*"]}}
    },
    {
      "Sid": "DenyUnencryptedTransport",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::lab-app-bucket", "arn:aws:s3:::lab-app-bucket/*"],
      "Condition": {"Bool": {"aws:SecureTransport": "false"}}
    }
  ]
}
